# Shared exclusions. Component-specific rules live beside each component.
# Policy and verification: docs/development/gitignore.md

# Local settings and credentials (keep the distributable template).
.env
.env.*
!.env.example
WiFiConfig.h
TailConfig.h
local.properties

# Python environments, caches and local tools.
.venv
venv
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
node_modules/

# Models and binary build products; download/build locally.
*.gguf
*.safetensors
*.ckpt
*.pt
*.pth
*.onnx
*.tflite
*.bin
*.apk
*.aab

# Private input/reference/generated media. Review each public asset explicitly.
*.wav
*.mp3
*.m4a
*.webm
*.mp4
*.flac
*.aac
*.opus
*.ogg
!Programs/ServerSide/dashboard/web/sounds/heartbeat.ogg

# Local diagnostic output, editor and OS files.
*.log
*.tmp
*.swp
*.swo
.DS_Store
Thumbs.db

# Local Original backups are not current source. Git history keeps source revisions.
Original-*/
*.Original
*.Original.*
