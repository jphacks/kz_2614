# Optional override: copy to .env.local; restart npm run dev after changing it.
# Without a setting, dev uses this team LAN origin (no path or credentials).
# An explicitly empty VOICE_API_UPSTREAM disables the dev voice proxy.
VOICE_API_UPSTREAM=http://192.168.100.113:8765
# Only if the voice server runs on the same computer as this Web dev server:
# VOICE_API_UPSTREAM=http://127.0.0.1:8765
