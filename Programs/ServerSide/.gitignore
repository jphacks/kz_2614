# Local settings, reference audio, recorded speech and acknowledgement assets.
# Keep a possible directory placeholder; never expose private data by extension.
/dashboard/data/*
!/dashboard/data/.gitkeep

# Model caches. Hide a local symlink; allow a real directory for README files.
/whisper
!/whisper/
/whisper/*
!/whisper/.gitkeep
!/whisper/README.md
/models

# External runtimes are fetched separately; retain repository placeholders/docs.
/STTLLMTTS/third_party/Irodori-TTS/*
!/STTLLMTTS/third_party/Irodori-TTS/.gitkeep
/STTLLMTTS/third_party/whisper/*
!/STTLLMTTS/third_party/whisper/.gitkeep
!/STTLLMTTS/third_party/whisper/README.md
