# LM Studio の音声用モデル。モデル名は利用環境に合わせて設定する。
LM_STUDIO_BASE_URL=http://127.0.0.1:1234
VOICE_LLM_MODEL=google/gemma-4-26b-a4b-qat
VOICE_LLM_MAX_TOKENS=160
VOICE_LLM_CONTEXT_LENGTH=4096
VOICE_LLM_TEMPERATURE=0.7
# GPU placement used by start-local.sh; reserve memory for Whisper and Irodori.
VOICE_LLM_GPU_RATIO=0.05
VOICE_LLM_HISTORY_MESSAGES=8
VOICE_LLM_TIMEOUT_SECONDS=45

# faster-whisper: the model is cached in ../whisper on first use.
# faster-whisper CUDA requires an NVIDIA driver plus CUDA 12 cuBLAS and cuDNN 9 runtime DLLs on PATH.
WHISPER_MODEL_ID=Systran/faster-whisper-small
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16
WHISPER_LANGUAGE=ja
WHISPER_LOCAL_FILES_ONLY=false
WHISPER_MAX_AUDIO_BYTES=25000000
WHISPER_MAX_AUDIO_SECONDS=60
WHISPER_TIMEOUT_SECONDS=90

# Server-side Silero VAD for continuous PCM input (browser / ESP32).
VOICE_VAD_THRESHOLD=0.65
VOICE_VAD_END_THRESHOLD=0.35
VOICE_VAD_MIN_SPEECH_MS=384
VOICE_VAD_SILENCE_MS=896
VOICE_VAD_PREROLL_MS=640
VOICE_VAD_MAX_SPEECH_SECONDS=20

# Irodori-TTS Gradio API. Start a compatible Irodori-TTS server at this URL.
VOICE_TTS_BACKEND=gradio
IRODORI_URL=http://127.0.0.1:7861/
VOICE_TTS_CHECKPOINT=Aratako/Irodori-TTS-600M-v3-VoiceDesign
# Change both model/codec devices to cpu and precisions to fp32 for CPU inference.
VOICE_TTS_MODEL_DEVICE=cuda
VOICE_TTS_MODEL_PRECISION=fp16
VOICE_TTS_CODEC_DEVICE=cuda
VOICE_TTS_CODEC_PRECISION=fp16
VOICE_TTS_CAPTION=落ち着いて親しみやすく、聞き取りやすい自然な日本語で話す。話者の声質を一定に保つ。
VOICE_TTS_OUTPUT_VOLUME_PERCENT=100
VOICE_TTS_SEED=1696307816543752105
# Optional reference voice sample, sent to the configured local TTS service.
VOICE_TTS_REFERENCE_AUDIO=
VOICE_TTS_MAX_AUDIO_BYTES=25000000
VOICE_TTS_TIMEOUT_SECONDS=90
# Optional direct local backend (no Gradio server and no generated audio files).
# Set VOICE_TTS_BACKEND=local and VOICE_TTS_CHECKPOINT=Aratako/Irodori-TTS-v4.1-Small
# or an existing model.safetensors path. Use bf16 on CUDA, fp32 on CPU.
# IRODORI_SOURCE_DIR=/absolute/path/to/Irodori-TTS
# IRODORI_CODEC_REPO=/absolute/path/to/weights.pth
# HF_HOME=/absolute/path/to/models/huggingface
IRODORI_LOCAL_FILES_ONLY=true
IRODORI_NUM_STEPS=
IRODORI_MAX_SECONDS=30
# Generate one cached acknowledgement if the LLM has not answered after this delay.
VOICE_ACK_DELAY_SECONDS=0.9

# PC側でMCPを起動し、会話からトントン頻度の保存・取得だけを許可する。
TAIL_MCP_ENABLED=false
TAIL_DASHBOARD_URL=http://127.0.0.1:8765
# Optional: NENGITSUNE_TAIL_SETTINGS_PATH=/absolute/path/to/tail_settings.json
# 旧機器操作は別機能。ESP32実装は外部担当のため無効のままにする。
TAIL_CONTROL_ENABLED=false
TAIL_DEVICE_URL=

# Saved reference audio is retained; only this prefix is used for voice conditioning.
IRODORI_REFERENCE_MAX_SECONDS=5
IRODORI_CPU_THREADS=2
